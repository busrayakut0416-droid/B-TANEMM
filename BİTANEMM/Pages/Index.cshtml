@page
@model IndexModel
@{
    ViewData["Title"] = "Henüz Yaşanmamış Hikâyemiz";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Henüz Yaşanmamış Hikâyemiz</title>

    <link rel="stylesheet" href="~/css/style.css" />
</head>

<body>

    <!-- MÜZİK -->
    <audio id="backgroundMusic" loop>
        <source src="A/a.aac" type="audio/mpeg">
    </audio>


    <!-- ARKA PLAN YILDIZLARI -->
    <div id="stars"></div>


    <!-- SAHNE 1 -->
    <section class="scene intro-scene active">

        <div class="cinema-line top"></div>

        <div class="intro-content">

            <div class="tiny-label">
                BİR HİKÂYE...
            </div>

            <h1>
                Muhammed Akkuş için
                <br>
                hazırlanmış.
            </h1>

            <p class="intro-subtitle">
                Bazı hikâyeler yaşanmadan önce yazılır.
            </p>

            <button id="startBtn" class="main-button">
                ❤️ Hikâyemize gir
            </button>

        </div>

        <div class="scroll-hint">
            dokun ve başla
        </div>

        <div class="cinema-line bottom"></div>

    </section>


    <!-- SAHNE 2 -->
    <section class="scene">

        <div class="scene-number">01</div>

        <div class="scene-content">

            <span class="eyebrow">SENİ TANIMAK</span>

            <h2>
                Biliyor musun?
            </h2>

            <div class="memory-list">

                <div class="memory-card">
                    <span>01</span>
                    <p> BitanemM yakışıklıda bişey.</p>
                </div>

                <div class="memory-card">
                    <span>02</span>
                    <p>Sanki biraz duygusal bi okadar güçlü insanların onu kötü yaptığını artık kendini düşüneceğini söylüyor nedense hayla gözümde kırılgan çocuk gibi.</p>
                </div>

                <div class="memory-card">
                    <span>03</span>
                    <p> Hayatıma dair birçok şeyi onunla yapmak istediğim biri.</p>
                </div>

                <div class="memory-card">
                    <span>04</span>
                    <p>
                        Yıllardır ekranın diğer tarafında olmasına rağmen
                        hayatımda gerçek bir yer edinmiş .
                    </p>
                </div>

            </div>

            <div class="heart-divider">♥</div>

            <p class="scene-text">
                Seni özel yapan şeylerden biri de kendin olman Batman`lım.
            </p>

        </div>

    </section>


    <!-- SAHNE 3 -->
    <section class="scene dark-scene">

        <div class="scene-number">02</div>

        <div class="scene-content">

            <span class="eyebrow">ZAMAN</span>

            <h2>
                Konuşmaya başladığımızdan beri...
            </h2>

            <div class="counter">

                <div>
                    <strong id="days">0000</strong>
                    <span>GÜN</span>
                </div>

                <div>
                    <strong id="hours">00</strong>
                    <span>SAAT</span>
                </div>

                <div>
                    <strong id="minutes">00</strong>
                    <span>DAKİKA</span>
                </div>

                <div>
                    <strong id="seconds">00</strong>
                    <span>SANİYE</span>
                </div>

            </div>

            <p class="quote">
                Garip değil mi?
                <br><br>
                Bunca zaman geçti ve hâlâ birlikte
                gerçekleştiremediğimiz bir sürü ilkimiz var.
            </p>

        </div>

    </section>


    <!-- SAHNE 4 -->
    <section class="scene dream-scene">

        <div class="scene-number">03</div>

        <div class="scene-content">

            <span class="eyebrow">BİR GÜN</span>

            <h2>
                Bizim hayalimiz...
            </h2>

            <div class="dream">

                <div class="dream-item">
                    <span>🌄</span>
                    <p>Taraşta:) <br> belki bi evimiz.</p>
                </div>

                <div class="dream-item">
                    <span>🌳</span>
                    <p> çilek tarlası önemli.</p>
                </div>

                <div class="dream-item">
                    <span>🐑</span>
                    <p> senin bakıcağın hayvanlarımız .</p>
                </div>

                <div class="dream-item">
                    <span>☕</span>
                    <p> Nice güzel sabahlarımız.</p>
                </div>

                <div class="dream-item">
                    <span>🌙</span>
                    <p> İyi Gecelerimiz.</p>
                </div>

            </div>

            <p class="big-dream">
                Bir gün kalabalıklardan uzak,
                <br>
                Beraber en baştan yeni bir hayata başlamak.
            </p>

        </div>

    </section>


    <!-- SAHNE 5 -->
    <section class="scene letter-scene">

        <div class="scene-number">04</div>

        <div class="letter">

           

            <h2>
                Birkaç cümle...
            </h2>

            <div class="letter-text">

                <p>
                    Bunca zaman konuşup da bazı şeyleri hâlâ
                    kelimelere sığdıramamış olmam biraz komik.
                </p>

                <p>
                    Bizim hikâyemizde güzel konuşmalar da oldu,
                    yanlış anladığımız şeyler de, kırıldığımız
                    zamanlar da...
                </p>

                <p>
                    Ama bütün bunların arasında değişmeyen bir şey vardı:
                    seni gerçekten tanımış sevmiş olmak.
                </p>

                <p>
                    Bazen bir insan hayatımıza çok uzaktan girer.
                    Ekranın diğer tarafından...
                    Bir mesajla, bir konuşmayla, bazen küçücük
                    bir cümleyle ama sanki hep hayatımdaymışşın gibi.
                </p>

                <p>
                    Sonra fark etmeden canım oldun
                </p>

                <p>
                    Belki her şeyi kusursuz yapamadık.
                    Belki bazı anlarda birbirimizi yeterince
                    anlayamadık.
                </p>

                <p>
                    Ama senden istediğim şey büyük sözler değil.
                </p>

                <p>
                    Sadece seni ne kadar
                    önemsediğimi hissetmen.
                </p>

                <p class="letter-ending">
                    bazı şeylerin değeri iki insan için neyi ifade ettiği önemli gibi.
                </p>

            </div>

            <div class="kiss">
                💋
            </div>

        </div>

    </section>


    <!-- SAHNE 6 -->
    <section class="scene maybe-scene">

        <div class="scene-number">05</div>

        <div class="maybe-content">

            <span class="eyebrow">BELKİ...</span>

            <p class="maybe-line first">
                Belki bazı insanlar birbirlerinin hayatına
                yanlış zamanda girer.
            </p>

            <p class="maybe-line second">
                Belki de zaman, bazı şeyleri değiştirmek için değil..doğru zamana saklamak için
            </p>

            <p class="maybe-line third">
               Bu konuda kafam biraz karışık mesela sevdiğin birini kadere bırakmak yada devam edip zamanla tüm sevgiyi bitirmek ileriye yönelik aradaki mesafe baya uzun olduğu için bilemedim bu sorunun cevabını .
            </p>

            <div class="floating-heart">
                ❤️
            </div>

        </div>

    </section>


    <!-- SAHNE 7 -->
    <section class="scene final-scene">

        <div class="final-content">

            <div class="moon">🌙</div>

            <span class="eyebrow">
                HENÜZ YAŞANMAMIŞ HİKÂYEMİZ
            </span>

            <h2>
                Bizim hikâyemiz
            </h2>

            <p class="final-text">
                Bi gün istediğimiz yere ulaşıp valla ne çektiğimi hergün dile getiricem  
                 ama en çok seni küçük halimi bilmene seviniyorum umarım herşeyi atlattığımızın sevincinide yaşıyabiliriz
                
            </p>

            <div class="final-heart">
                ❤️
            </div>

            <p class="final-last">
                Henüz yaşanmamış bütün güzel günlerimize...
            </p>

            <button id="replayBtn" class="main-button">
                🌙 Hikâyeyi yeniden izle
            </button>

        </div>

    </section>


    <script src="~/js/script.js"></script>

</body>
</html>